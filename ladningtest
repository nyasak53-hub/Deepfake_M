<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DeepfakeMed | AI-Powered Diagnostic Integrity</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* === GLASSMORPHISM & THEMED INLINE CSS === */
        :root {
            --bg-color: #080a0f;
            --card-bg: rgba(17, 21, 31, 0.65);
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-cyan: #00b0ff;
            --accent-purple: #7c4dff;
            --accent-green: #00e676;
            --text-main: #ffffff;
            --text-muted: #8e9bb0;
            --glass-blur: blur(16px);
            --code-bg: #080a0f;
            --nav-bg: rgba(8, 10, 15, 0.7);
        }

        [data-theme="light"] {
            --bg-color: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.75);
            --card-border: rgba(0, 0, 0, 0.08);
            --text-main: #0f172a;
            --text-muted: #475569;
            --code-bg: #1e293b;
            --nav-bg: rgba(255, 255, 255, 0.8);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
        }

        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-image: 
                linear-gradient(to right, rgba(125, 125, 125, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(125, 125, 125, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: -2;
        }

        .glow-orb {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(140px);
            opacity: 0.2;
            z-index: -1;
            pointer-events: none;
        }

        .glow-1 { top: -150px; left: -100px; background: var(--accent-cyan); }
        .glow-2 { bottom: -150px; right: -100px; background: var(--accent-purple); }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            border-bottom: 1px solid var(--card-border);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            background: var(--nav-bg);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.5px;
            color: var(--text-main);
        }

        .logo i { color: var(--accent-green); }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .nav-links a:hover { color: var(--text-main); }

        .nav-controls {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .theme-btn {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            padding: 8px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .color-input {
            -webkit-appearance: none;
            appearance: none;
            width: 28px;
            height: 28px;
            background: transparent;
            border: none;
            cursor: pointer;
            border-radius: 50%;
        }

        .color-input::-webkit-color-swatch {
            border: 2px solid var(--card-border);
            border-radius: 50%;
        }

        .btn-launch {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            color: #ffffff;
            padding: 10px 22px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            box-shadow: 0 4px 20px rgba(0, 176, 255, 0.25);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-launch:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 28px rgba(0, 176, 255, 0.4);
        }

        .hero {
            padding: 100px 8% 60px;
            text-align: center;
            max-width: 1000px;
            margin: 0 auto;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 230, 118, 0.1);
            border: 1px solid rgba(0, 230, 118, 0.3);
            color: var(--accent-green);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: 3.8rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -1.5px;
            margin-bottom: 24px;
            color: var(--text-main);
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            max-width: 750px;
            margin-left: auto;
            margin-right: auto;
        }

        .cta-group {
            display: flex;
            gap: 18px;
            justify-content: center;
            align-items: center;
        }

        .btn-secondary {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            padding: 12px 28px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            backdrop-filter: var(--glass-blur);
        }

        .preview-window {
            margin: 70px auto 0;
            max-width: 950px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .window-header {
            background: var(--nav-bg);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--card-border);
        }

        .dot { width: 12px; height: 12px; border-radius: 50%; }
        .dot-red { background: #ff5f56; }
        .dot-yellow { background: #ffbd2e; }
        .dot-green { background: #27c93f; }

        .window-title {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-left: 10px;
            font-family: monospace;
        }

        .window-body {
            padding: 30px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            text-align: left;
        }

        .code-block {
            background: var(--code-bg);
            border: 1px solid var(--card-border);
            padding: 20px;
            border-radius: 10px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.85rem;
            color: #a0aec0;
        }

        .code-keyword { color: #f6ad55; }
        .code-func { color: #63b3ed; }
        .code-str { color: #68d391; }

        .features-section {
            padding: 100px 8%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 50px;
            color: var(--text-main);
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
        }

        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            padding: 35px;
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            border-color: var(--accent-cyan);
        }

        .icon-wrapper {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: rgba(0, 176, 255, 0.1);
            color: var(--accent-cyan);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .feature-card h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .feature-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            .window-body { grid-template-columns: 1fr; }
            .nav-links { display: none; }
        }
    </style>
</head>
<body>

    <div class="bg-grid"></div>
    <div class="glow-orb glow-1"></div>
    <div class="glow-orb glow-2"></div>

    <nav>
        <div class="logo">
            <i class="fa-solid fa-shield-virus"></i> DeepfakeMed
        </div>
        <ul class="nav-links">
            <li><a href="#features">Architecture</a></li>
            <li><a href="#forensics">Forensics Engine</a></li>
            <li><a href="#docs">Documentation</a></li>
        </ul>
        <div class="nav-controls">
            <button type="button" class="theme-btn" onclick="toggleTheme()" id="landing-theme-btn">
                <i class="fa-solid fa-moon" id="landing-theme-icon"></i>
            </button>
            <input type="color" class="color-input" id="landing-color-picker" value="#00b0ff" oninput="changeAccentColor(this.value)">
            <a href="/app" class="btn-launch">
                <span>Try DeepfakeMed</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </nav>

    <section class="hero">
        <div class="badge">
            <i class="fa-solid fa-bolt"></i> Powered by Groq Llama-3 & Pixel Forensics
        </div>
        <h1>Securing Medical Imaging Against AI Synthetic Tampering</h1>
        <p>A multi-layered forensic platform that detects subtle GAN manipulations, pixel noise distribution shifts, and adversarial edits in CT, MRI, and X-ray scans in real-time.</p>
        
        <div class="cta-group">
            <a href="/app" class="btn-launch" style="padding: 14px 34px; font-size: 1rem;">
                Try Application Now <i class="fa-solid fa-wand-magic-sparkles"></i>
            </a>
            <a href="#features" class="btn-secondary">Read Technical Spec</a>
        </div>

        <div class="preview-window">
            <div class="window-header">
                <div class="dot dot-red"></div>
                <div class="dot dot-yellow"></div>
                <div class="dot dot-green"></div>
                <span class="window-title">deepfakemed_inspection.py</span>
            </div>
            <div class="window-body">
                <div class="code-block">
                    <span class="code-keyword">import</span> deepfakemed <span class="code-keyword">as</span> dfm<br><br>
                    <span class="code-keyword">async def</span> <span class="code-func">verify_scan</span>(dcm_file):<br>
                    &nbsp;&nbsp;model = dfm.<span class="code-func">ForensicPipeline</span>(mode=<span class="code-str">"statistical"</span>)<br>
                    &nbsp;&nbsp;score = <span class="code-keyword">await</span> model.<span class="code-func">analyze</span>(dcm_file)<br>
                    &nbsp;&nbsp;<span class="code-keyword">return</span> score.<span class="code-func">authenticity</span>
                </div>
                <div style="display: flex; flex-direction: column; justify-content: center; gap: 10px;">
                    <div style="font-weight: 600; color: #00e676;"><i class="fa-solid fa-check-circle"></i> Authenticity Score: 89.4% (Verified)</div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">Discrete Fourier Transform (DFT) verified uniform high-frequency sensor noise.</div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">Zero GAN boundary interpolation seams detected.</div>
                </div>
            </div>
        </div>
    </section>

    <section class="features-section" id="features">
        <h2 class="section-title">Built for Clinical Integrity & Research Safety</h2>
        <div class="grid-3">
            <div class="feature-card">
                <div class="icon-wrapper"><i class="fa-solid fa-chart-line"></i></div>
                <h3>Pixel Noise Distribution</h3>
                <p>Identifies high-frequency variance shifts and smooth patches typical of generative artificial intelligence fill algorithms.</p>
            </div>
            <div class="feature-card">
                <div class="icon-wrapper"><i class="fa-solid fa-microscope"></i></div>
                <h3>Texture Heatmap Analysis</h3>
                <p>Spots micro-texture inconsistencies where neural networks fail to accurately mirror realistic biological tissue patterns.</p>
            </div>
            <div class="feature-card">
                <div class="icon-wrapper"><i class="fa-solid fa-brain"></i></div>
                <h3>Groq AI Assistant</h3>
                <p>Provides clinicians with plain-language, real-time diagnostic reports breaking down the specific reasons why a scan passes or fails.</p>
            </div>
        </div>
    </section>

    <script>
        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('dfm_theme', newTheme);

            const icon = document.getElementById('landing-theme-icon');
            if (icon) {
                icon.className = newTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
        }

        function changeAccentColor(color) {
            document.documentElement.style.setProperty('--accent-cyan', color);
            localStorage.setItem('dfm_accent', color);
        }

        window.addEventListener('load', () => {
            const savedTheme = localStorage.getItem('dfm_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
            const icon = document.getElementById('landing-theme-icon');
            if (icon) {
                icon.className = savedTheme === 'light' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }

            const savedAccent = localStorage.getItem('dfm_accent') || '#00b0ff';
            document.documentElement.style.setProperty('--accent-cyan', savedAccent);
            const picker = document.getElementById('landing-color-picker');
            if (picker) picker.value = savedAccent;
        });
    </script>
</body>
</html>